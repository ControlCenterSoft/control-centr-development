{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/security-overview-v1.schema.json",
  "title": "Control Center Security Overview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "generated_at",
    "identity",
    "self_only",
    "mutation_authorized",
    "first_login",
    "password_change_required",
    "password_lifecycle",
    "session_policy",
    "session_count",
    "current_session_id",
    "sessions",
    "grant_count",
    "permission_count",
    "has_wildcard_permission",
    "grants",
    "attention"
  ],
  "properties": {
    "contract_version": { "const": "ui.security-overview/v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "identity": { "$ref": "#/$defs/identity" },
    "self_only": { "const": true },
    "mutation_authorized": { "const": false },
    "first_login": {
      "type": "string",
      "enum": ["password_change_required", "complete_or_not_required"]
    },
    "password_change_required": { "type": "boolean" },
    "password_lifecycle": { "$ref": "#/$defs/passwordLifecycle" },
    "session_policy": { "$ref": "#/$defs/sessionPolicy" },
    "session_count": { "type": "integer", "minimum": 1, "maximum": 128 },
    "current_session_id": { "$ref": "#/$defs/identifier" },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/session" }
    },
    "grant_count": { "type": "integer", "minimum": 0, "maximum": 64 },
    "permission_count": { "type": "integer", "minimum": 0 },
    "has_wildcard_permission": { "type": "boolean" },
    "grants": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/grant" }
    },
    "attention": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["password_change_required", "no_effective_grants"]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "username", "display_name", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "username": { "$ref": "#/$defs/identifier" },
        "display_name": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "passwordLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "changed_at", "change_required"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["change_required", "active"]
        },
        "changed_at": { "type": "string", "format": "date-time" },
        "change_required": { "type": "boolean" }
      }
    },
    "sessionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_ttl_seconds",
        "idle_timeout_seconds",
        "activity_refreshes_idle_deadline",
        "activity_extends_absolute_expiry"
      ],
      "properties": {
        "absolute_ttl_seconds": { "type": "integer", "minimum": 60 },
        "idle_timeout_seconds": { "type": "integer", "minimum": 60 },
        "activity_refreshes_idle_deadline": { "type": "boolean" },
        "activity_extends_absolute_expiry": { "const": false }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "last_activity_at",
        "idle_expires_at",
        "expires_at",
        "current"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "created_at": { "type": "string", "format": "date-time" },
        "last_activity_at": { "type": "string", "format": "date-time" },
        "idle_expires_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "source_ip": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "user_agent": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "current": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["global", "tenant", "site", "resource"]
        },
        "id": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_name", "scope", "permissions"],
      "properties": {
        "role_name": { "$ref": "#/$defs/identifier" },
        "scope": { "$ref": "#/$defs/scope" },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
