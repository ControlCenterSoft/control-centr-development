{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/release-candidate-readiness-0.32-v1.schema.json",
  "title": "Control Center 0.32 release candidate readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stable_version",
    "stable_tag",
    "stable_artifact_digest",
    "candidate_version",
    "candidate_sha",
    "gates"
  ],
  "properties": {
    "schema": {
      "const": "control-center.release-candidate-readiness.0.32.v1"
    },
    "stable_version": {
      "const": "0.31.1"
    },
    "stable_tag": {
      "const": "v0.31.1"
    },
    "stable_artifact_digest": {
      "const": "sha256:b9d6467c7c95a6e7e8597398c1b6e7327d319058d248e9cd0416c5baf9699c97"
    },
    "candidate_version": {
      "const": "0.32.0"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gates": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/gateEvidence"
      }
    }
  },
  "$defs": {
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "candidate_sha"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "enum": [
            "health_incidents_audit_reports_integration",
            "candidate_artifact_packaging",
            "clean_install",
            "upgrade_from_stable_0_31_1",
            "rollback_forward_recovery",
            "postgres_restart_reconnect",
            "security_privacy",
            "commercial_legal_clearance",
            "release_metadata"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "blocked",
            "pass"
          ]
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
